<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rapid_nav_tools</name>
  <version>0.1.0</version>
  <description>sim_check: one command that checks the RAPID-NAV simulation (topic rates, sensor content, TF, a scripted drive against ground truth) and writes a bundle.</description>
  <maintainer email="harsh.v.sharma@outlook.com">Harsh Vardhan</maintainer>
  <license>MIT</license>

  <author>Rishi Atreya</author>
  <author>Kamalesh Kumar B</author>
  <author>Jaspinder Kaur</author>
  <author>Harsh Vardhan</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
