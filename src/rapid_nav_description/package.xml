<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rapid_nav_description</name>
  <version>0.1.0</version>
  <description>Xacro model of the RAPID-NAV differential-drive robot: body, wheels, casters, RGB-D camera, IMU and lidar, with Gazebo plugins.</description>
  <maintainer email="harsh.v.sharma@outlook.com">Harsh Vardhan</maintainer>
  <license>MIT</license>

  <author>Rishi Atreya</author>
  <author>Kamalesh Kumar B</author>
  <author>Jaspinder Kaur</author>
  <author>Harsh Vardhan</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>liburdfdom-tools</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
