<?xml version="1.0"?>
<!-- Every number of the robot model, in one place. Units: metres, radians, kilograms. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Body. base_link sits on the wheel axis, base_footprint is on the ground. -->
  <xacro:property name="base_link_height" value="0.05"/>
  <xacro:property name="chassis_radius" value="0.20"/>
  <xacro:property name="chassis_length" value="0.14"/>
  <xacro:property name="chassis_z" value="0.07"/>
  <xacro:property name="chassis_mass" value="6.0"/>
  <xacro:property name="deck_radius" value="0.19"/>
  <xacro:property name="deck_length" value="0.01"/>
  <xacro:property name="deck_z" value="0.145"/>
  <xacro:property name="bumper_radius" value="0.205"/>
  <xacro:property name="bumper_length" value="0.03"/>
  <xacro:property name="bumper_z" value="0.03"/>
  <xacro:property name="mount_size_x" value="0.03"/>
  <xacro:property name="mount_size_y" value="0.06"/>
  <xacro:property name="mount_size_z" value="0.0125"/>
  <xacro:property name="mount_x" value="0.17"/>
  <xacro:property name="mount_z" value="0.15625"/>

  <!-- Driving wheels and casters. -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_length" value="0.035"/>
  <xacro:property name="wheel_y" value="0.225"/>
  <xacro:property name="wheel_mass" value="0.4"/>
  <xacro:property name="wheel_roll" value="1.5708"/>
  <xacro:property name="hub_radius" value="0.025"/>
  <xacro:property name="hub_length" value="0.037"/>
  <xacro:property name="wheel_separation" value="0.45"/>
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_x" value="0.15"/>
  <xacro:property name="caster_z" value="-0.025"/>
  <xacro:property name="caster_mass" value="0.1"/>

  <!-- Turret, lidar, camera and IMU. -->
  <xacro:property name="turret_z" value="0.18"/>
  <xacro:property name="turret_radius" value="0.04"/>
  <xacro:property name="turret_length" value="0.06"/>
  <xacro:property name="turret_mass" value="0.05"/>
  <xacro:property name="lidar_z" value="0.225"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_length" value="0.03"/>
  <xacro:property name="lidar_mass" value="0.17"/>
  <xacro:property name="camera_x" value="0.175"/>
  <xacro:property name="camera_z" value="0.175"/>
  <xacro:property name="camera_box_x" value="0.025"/>
  <xacro:property name="camera_box_y" value="0.09"/>
  <xacro:property name="camera_box_z" value="0.025"/>
  <xacro:property name="camera_mass" value="0.07"/>
  <xacro:property name="camera_optical_roll" value="-1.5708"/>
  <xacro:property name="camera_optical_pitch" value="0.0"/>
  <xacro:property name="camera_optical_yaw" value="-1.5708"/>
  <xacro:property name="imu_z" value="0.10"/>
  <xacro:property name="imu_size" value="0.01"/>
  <xacro:property name="imu_mass" value="0.01"/>

  <!-- Sensor settings (the camera's size, rate and field of view are arguments of the top file). -->
  <xacro:property name="camera_clip_near" value="0.1"/>
  <xacro:property name="camera_clip_far" value="10.0"/>
  <xacro:property name="camera_noise_stddev" value="0.007"/>
  <xacro:property name="lidar_rate" value="10"/>
  <xacro:property name="lidar_samples" value="360"/>
  <xacro:property name="lidar_min_angle" value="-3.14159"/>
  <xacro:property name="lidar_max_angle" value="3.12414"/>
  <xacro:property name="lidar_range_min" value="0.12"/>
  <xacro:property name="lidar_range_max" value="12.0"/>
  <xacro:property name="lidar_range_resolution" value="0.01"/>
  <xacro:property name="lidar_noise_stddev" value="0.01"/>
  <xacro:property name="imu_rate" value="200"/>
  <xacro:property name="imu_gyro_noise_stddev" value="0.0025"/>
  <xacro:property name="imu_gyro_bias_stddev" value="0.0005"/>
  <xacro:property name="imu_accel_noise_stddev" value="0.02"/>
  <xacro:property name="imu_accel_bias_stddev" value="0.01"/>

  <!-- Gazebo friction and the model plugins. -->
  <xacro:property name="wheel_mu" value="1.0"/>
  <xacro:property name="caster_mu" value="0.0"/>
  <xacro:property name="wheel_max_linear_velocity" value="0.6"/>
  <xacro:property name="wheel_max_angular_velocity" value="2.0"/>
  <xacro:property name="wheel_max_linear_acceleration" value="1.0"/>
  <xacro:property name="wheel_max_angular_acceleration" value="3.0"/>
  <xacro:property name="odom_publish_frequency" value="50"/>

</robot>
